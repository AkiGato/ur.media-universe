# Optional. The causal-research instrument (src/data/causalResearch.ts) can use
# a build-time Gemini key as a fallback. Vite only exposes variables prefixed
# VITE_ to client code, so this is the one name the code can read.
#
# A key the reader enters in the app (kept in their own localStorage) always
# takes precedence, and the instrument is opt-in — nothing is requested from any
# third party until the reader invokes it.
#
# Copy to .env.local (git-ignored) to set it. Leave unset to ship with no key.
VITE_GEMINI_API_KEY=


# ── Report route (Brevo) ────────────────────────────────────────────────────
# Server-side ONLY. None of these carry the VITE_ prefix, which is the security
# boundary: Vite bundles VITE_-prefixed names into client code and nothing else,
# so the API key cannot reach the browser. Renaming it VITE_BREVO_API_KEY would
# publish it to every visitor.
#
# Copy to .env.local (git-ignored) and fill in. Without BREVO_API_KEY the route
# answers 503 and the form is simply not offered.
BREVO_API_KEY=
# The list new contacts join.
BREVO_LIST_ID=5
# Must be a VERIFIED sender in Brevo, or every send is rejected.
BREVO_SENDER_EMAIL=aki.gato.tech@gmail.com
# Where reports are delivered.
REPORT_TO_EMAIL=aki.gato.tech@gmail.com
