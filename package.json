{
  "name": "media-as-universe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --port=3000",
    "build": "node node_modules/vite/bin/vite.js build && npm run stamp-sw",
    "stamp-sw": "node scripts/stamp-sw.mjs",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "audit:lines": "node scripts/audits/static/audit-lines.mjs",
    "lint": "node node_modules/typescript/bin/tsc --noEmit && npm run audit:lines && npm run audit:relations",
    "audit:relations": "node scripts/audits/static/audit-relations.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
